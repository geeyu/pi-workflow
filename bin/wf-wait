#!/usr/bin/env bash
# wf-wait:步骤状态守望(后台运行,不阻塞 agent)
#
# 定位:主控派发/注入后,不要用前台死循环轮询占住 agent——把本脚本放后台
# (nohup),它监听目标步骤的状态迁移,只把变化写进日志;agent 每轮开头
# `tail 日志` 即可瞬时判断,真正的唤醒由插件 monitor 的 followUp 通知负责。
#
# 用法:
#   wf-wait <stepId...> [--workflow <id>] [--timeout <sec>] [--interval <sec>]
#           [--until <s1,s2>] [--log <file>]
#
#   stepId:完整 id(wf-enhance2-1.1)或 --workflow 给定时的点号 id(1.1)
#   --until 默认 "reported,done,skipped"(回报即视为可核对)
#   --log   默认 /tmp/wf-wait.log(后台运行时务必指定)
#
# 退出码:0=全部达成;1=超时;2=任一目标进入失败态(failed/aborted/needs-fix/conflict);
#         3=用法错误或步骤不存在。
set -u

DB="${WF_DB_PATH:-$HOME/.pi/agent/workflows/workflow.db}"
TIMEOUT=1800
INTERVAL=10
UNTIL="reported,done,skipped"
LOG=""
WF=""
STEPS=()

while [ $# -gt 0 ]; do
	case "$1" in
		--timeout) TIMEOUT="${2:-1800}"; shift 2 ;;
		--interval) INTERVAL="${2:-10}"; shift 2 ;;
		--until) UNTIL="${2:-}"; shift 2 ;;
		--log) LOG="${2:-}"; shift 2 ;;
		--workflow) WF="${2:-}"; shift 2 ;;
		-*) echo "未知参数: $1"; exit 3 ;;
		*) STEPS+=("$1"); shift ;;
	esac
done

if [ ${#STEPS[@]} -eq 0 ] || [ -z "$UNTIL" ]; then
	echo "用法: wf-wait <stepId...> [--workflow <id>] [--timeout N] [--interval N] [--until s1,s2] [--log file]" >&2
	exit 3
fi
if [ ! -f "$DB" ]; then
	echo "数据库不存在: $DB" >&2
	exit 3
fi

# 点号 id 在 --workflow 下补全
IDS=()
for s in "${STEPS[@]}"; do
	if [[ "$s" =~ ^[0-9.]+$ ]] && [ -n "$WF" ]; then
		IDS+=("$WF-$s")
	else
		IDS+=("$s")
	fi
done

# 达成/失败集合
IFS=',' read -r -a WANTED <<<"$UNTIL"
want() { local st="$1"; for w in "${WANTED[@]}"; do [ "$st" = "$w" ] && return 0; done; return 1; }
FAIL_SET="failed aborted needs-fix conflict"

log() {
	local line
	line="$(date +%H:%M:%S) $*"
	if [ -n "$LOG" ]; then echo "$line" >>"$LOG"; else echo "$line"; fi
}

# 初始状态 + 步骤存在性校验(索引数组兼容 bash 3.2)
PREV=()
for id in "${IDS[@]}"; do
	st=$(sqlite3 "$DB" "SELECT status FROM workflow_steps WHERE id='$id'" 2>/dev/null)
	if [ -z "$st" ]; then
		echo "步骤不存在: $id" >&2
		exit 3
	fi
	PREV+=("$st")
	log "watch $id = $st"
done

DEADLINE=$(( $(date +%s) + TIMEOUT ))
while :; do
	ALLDONE=1
	ANYFAIL=0
	i=0
	for id in "${IDS[@]}"; do
		st=$(sqlite3 "$DB" "SELECT status FROM workflow_steps WHERE id='$id'" 2>/dev/null)
		st="${st:-missing}"
		if [ "${PREV[$i]:-}" != "$st" ]; then
			log "transition $id: ${PREV[$i]:-} → $st"
			PREV[$i]="$st"
		fi
		i=$(( i + 1 ))
		if want "$st"; then
			continue
		fi
		if [[ "$FAIL_SET" == *"$st"* ]]; then
			log "FAIL $id = $st"
			ANYFAIL=1
			continue
		fi
		ALLDONE=0
	done
	[ "$ANYFAIL" = 1 ] && exit 2
	[ "$ALLDONE" = 1 ] && { log "DONE: ${IDS[*]}"; exit 0; }
	[ "$(date +%s)" -ge "$DEADLINE" ] && { log "TIMEOUT ${TIMEOUT}s"; exit 1; }
	sleep "$INTERVAL"
done
